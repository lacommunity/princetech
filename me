/* -------------------------------------------------
    GLOBAL
--------------------------------------------------- */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    text-align: center;
    background-color: #f4f4f4;
}

#datetime {
    font-size: 14px;
    color: #fff;
    padding: 5px 10px;
    border-radius: 5px;
    position: absolute;
    top: 10px;
    right: 20px;
}

/* -------------------------------------------------
    HEADER / LOGO
--------------------------------------------------- */
header {
    background: #333;
    color: white;
    position: relative;
    padding: 10px 0;
    z-index: 10;
    box-shadow: 0px 8px 16px rgba(42, 137, 21, 0.796);
}

.logo {
    text-align: left;
    margin-top: 15px;
    position: fixed;
    margin-left: 0;
    z-index: 11;
}

.logo img {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 4px solid transparent;
    background: linear-gradient(45deg, #19991fda, #474648cd);
}

/* -------------------------------------------------
    NAVIGATION
--------------------------------------------------- */
nav {
    z-index: 12;
    background-color: #333;
    padding: 10px 0;
    margin-top: 10px;
}

nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
}

nav ul li {
    z-index: 10;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    padding: 10px 15px;
    display: block;
    transition: color 0.3s ease;
    font-size: smaller;
}

nav ul li:hover {
    background-color: rgba(42, 137, 21, 0.796);
    border-radius: 10px;
    box-shadow: 0px 8px 16px rgba(165, 161, 161, 0.335);
    transform: translateY(-5px);
    transition: background-color 0.3s ease, transform 0.3s ease;
}

nav ul li:hover a {
    color: #ffffff;
}

/* -------------------------------------------------
    SECTIONS
--------------------------------------------------- */
section {
    padding: 40px 20px;
    background: white;
    margin: 20px;
    border-radius: 10px 50px 10px 50px;
    box-shadow: 0 0 10px rgba(6,39,2,0.1);
}

.two-sections {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    margin-top: 40px;
    padding: 20px;
    flex-wrap: wrap;
}

.left-box,
.right-box {
    flex: 1;
    min-width: 300px;
    background: #f5f5f5;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 8px rgba(0,0,0,0.533);
    transition: 0.9s;

    /* Animation */
    opacity: 0;
    animation: fadeUp 1.9s ease forwards;
}

.left-box { animation-delay: 1.5s; }
.right-box { animation-delay: 1.9s; }

.left-box:hover,
.right-box:hover {
    transform: translateY(-5px);
}

.left-box h3,
.right-box h3 {
    color: #333;
    margin-bottom: 10px;
}

.left-box ul li {
    margin-bottom: 5px;
}

/* -------------------------------------------------
    TEAM SECTION
--------------------------------------------------- */
#team {
    margin-top: 50px;
    padding: 20px;
    text-align: center;
}

.team-title {
    font-size: 28px;
    margin-bottom: 30px;
    font-weight: bold;
}

.team-container {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
}

.team-member {
    background: white;
    padding: 20px;
    width: 280px;
    border-radius: 12px;
    box-shadow: 0 0 10px rgba(0,0,0,0.598);
    transition: 0.9s;

    /* Animation */
    opacity: 0;
    animation: fadeUp 0.9s ease forwards;
}

.team-member:nth-child(1) { animation-delay: 1.5s; }
.team-member:nth-child(2) { animation-delay: 1.9s; }


.team-member:hover {
    transform: translateY(-5px);
}

.team-member img {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid transparent;
    background: linear-gradient(45deg, #19991fda, #474648cd);
    margin-bottom: 15px;
}

.team-member h3 {
    margin-bottom: 5px;
    font-size: 20px;
}

.role {
    font-weight: bold;
    color: #0d6efd;
    margin-bottom: 10px;
}

.desc {
    font-size: 14px;
    color: #555;
}

/* -------------------------------------------------
    PROFILE
--------------------------------------------------- */
.profile {
    text-align: center;
    margin-top: 20px;
}

.profile img {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    border: 4px solid transparent;
    background: linear-gradient(45deg, #19991fda, #474648cd);
}

.profile h3 {
    margin-top: 10px;
    color: #333;
}

/* -------------------------------------------------
    FOOTER
--------------------------------------------------- */
footer {
    background: #333;
    color: white;
    padding: 5px;
    margin-top: 10px;
}

/* -------------------------------------------------
    ANIMATION
--------------------------------------------------- */
@keyframes fadeUp {
    0% {
        opacity: 0;
        transform: translateY(40px);
    }
    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

/* -------------------------------------------------
    MOBILE FIXES (≤ 480px)
--------------------------------------------------- */
@media screen and (max-width: 480px) {

    body {
        padding: 0;
        margin: 0;
        overflow-x: hidden;
    }

    header {
        padding: 5px;
        text-align: center;
    }

    .logo {
        position: relative;
        margin: 10px auto;
        text-align: center;
    }

    .logo img {
        width: 60px;
        height: 60px;
    }

    nav {
        padding: 5px 0;
        margin-top: 0;
    }

    nav ul {
        flex-direction: column;
        gap: 5px;
        padding: 0;
        margin: 0;
    }

    nav a {
        font-size: 12px;
        padding: 8px 10px;
    }

    section {
        margin: 10px;
        padding: 15px;
        border-radius: 10px;
    }

    .two-sections {
        flex-direction: column;
        gap: 15px;
        padding: 0;
    }

    .left-box,
    .right-box {
        min-width: 100%;
        padding: 15px;
    }

    .team-container {
        flex-direction: column;
        gap: 15px;
    }

    .team-member {
        width: 100%;
        padding: 15px;
    }

    .team-member img {
        width: 100px;
        height: 100px;
    }

    .team-title {
        font-size: 20px;
    }

    footer {
        font-size: 12px;
        padding: 5px;
    }
}





